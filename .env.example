# Docker Compose settings for the whole stack. Copy to .env and replace every placeholder.
# Never commit .env. Jenkins writes its own .env from credentials (see Jenkinsfile).

POSTGRES_DB=petgrooming
POSTGRES_USER=petgrooming
POSTGRES_PASSWORD=change_me_local_only

# Long random string, at least 32 characters.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

BACKEND_PORT=3000
FRONTEND_PORT=5173

# bcrypt hash of the staff@petgrooming.com password. Keep the single quotes: the hash contains '$'.
# Generate one with:
#   docker compose run --rm --no-deps backend node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# Only used when the database volume is created for the first time.
STAFF_PASSWORD_HASH='$2a$10$replace.with.a.real.bcrypt.hash.generated.as.shown.above'
